#!/usr/bin/env node

const dotenv = require('dotenv');
const { vopsEnvFiles } = require('../lib/lib/env-files');

// Tokens stay local; no telemetry. Which .env files those are is profile-aware and
// resolved in one place (lib/env-files) so this entrypoint and the Nest module can
// never disagree: a named profile must not inherit the shared ~/.config/vops/.env.
// `quiet` matters: dotenv's banner goes to STDOUT, and every `--json` command
// promises parseable stdout to whatever is reading it.
for (const envFile of vopsEnvFiles({ cwd: process.cwd() })) {
  dotenv.config({ path: envFile, quiet: true });
}

require('@oclif/core')
  .run()
  .then(require('@oclif/core').flush)
  .catch(require('@oclif/core').Errors.handle);
