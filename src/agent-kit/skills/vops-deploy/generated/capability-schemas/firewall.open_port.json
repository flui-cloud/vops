{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "pattern": "^(ssh|http|https|[0-9,-]+(?:/(?:tcp|udp))?)(?:@[0-9a-fA-F:./]+)?$"
    }
  },
  "required": [
    "target",
    "service"
  ],
  "additionalProperties": false
}
